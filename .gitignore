# Runtime / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Evaluation and experiment outputs
outs/
sc_outs/
lp_outs/
tests/

# Dataset policy:
# - keep original spreadsheet files
# - keep metadata / description files
# - keep one sample per derived format for each dataset
dataset/**
!dataset/
!dataset/**/

# Original spreadsheet files
!dataset/**/*.xls
!dataset/**/*.xlsx
!dataset/**/*.xlsm
!dataset/**/*.xlsb

# Full source spreadsheet set for SpreadsheetBench verified split
!dataset/spreadsheetbench/spreadsheetbench_verified_400/spreadsheet/**

# Metadata and dataset descriptions
!dataset/**/*.json
!dataset/**/*.yaml
!dataset/**/*.yml
!dataset/**/*.md
!dataset/**/README*
!dataset/数据集说明
!dataset/realhitbench/数据修复说明
!dataset/spreadsheetbench/process_for_image/图片生成的执行命令

# Processing scripts inside dataset folders
!dataset/**/*.py


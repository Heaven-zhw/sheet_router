cd /mnt/data/zhw/sheet_router

VOTE_ROOT="outs/sheetflex_vote/full_5models"

for MODEL in \
  gemma-3-12b-it \
  gemma-4-12B-it \
  gemma-4-26B-A4B-it \
  Qwen3.5-9B \
  Qwen3-VL-30B-A3B-Instruct
do
  echo "==================== $MODEL ===================="

  echo "[RealHiT Overall]"
  jq '.Overall' \
    "$VOTE_ROOT/$MODEL/realhit/sheetflex_vote_score.json"

  echo "[RealHiT Diagnostics]"
  jq '{
    tie_rate,
    logprob_tie_break_coverage,
    format_order_fallbacks,
    selected_format_distribution,
    all_candidates_invalid_samples
  }' "$VOTE_ROOT/$MODEL/realhit/sheetflex_vote_diagnostics.json"

  echo "[SpreadsheetBench Accuracy]"
  jq '.' \
    "$VOTE_ROOT/$MODEL/spreadsheet/spreadsheet_pot_accuracy.json"

  echo "[SpreadsheetBench Diagnostics]"
  jq '{
    tie_rate,
    logprob_tie_break_coverage,
    format_order_fallbacks,
    selected_format_distribution,
    average_pairwise_region_agreement,
    medoid_score_summary,
    all_candidates_invalid_samples
  }' "$VOTE_ROOT/$MODEL/spreadsheet/sheetflex_vote_diagnostics.json"
done